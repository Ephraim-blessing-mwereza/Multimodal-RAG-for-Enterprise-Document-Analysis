# Multimodal RAG Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (primary - recommended)
GOOGLE_API_KEY=your-google-api-key-here

# Alternative: OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Azure OpenAI (for enterprise deployments)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# Model Configuration
LLM_PROVIDER=gemini  # Options: gemini, openai
LLM_MODEL=gemini-1.5-pro  # Or: gemini-1.5-flash (faster/cheaper)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_TABLE_ROWS_PER_CHUNK=10

# Retrieval Configuration
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5
RELEVANCE_THRESHOLD=0.3

# Vector Database (for production)
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-east-1

# Logging
LOG_LEVEL=INFO
